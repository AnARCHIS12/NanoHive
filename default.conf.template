map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Preserve the client's original protocol when this container sits behind another
# reverse proxy (outer nginx / NPM / Traefik terminating TLS). $scheme here is how
# THIS container was reached - usually plain http - which would stomp the outer
# proxy's "X-Forwarded-Proto: https" and make ABS reject OIDC callback URLs as
# cross-origin (https callback vs http expected origin). Pass the incoming header
# through untouched; fall back to $scheme only when we are the edge proxy.
map $http_x_forwarded_proto $nh_fwd_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Server-wide ratings API (stars + reviews shared by all users). Implemented in
# njs so it runs inside this same container; the module is loaded from nginx.conf
# (load_module line added in the Dockerfile).
js_path "/etc/nginx/njs/";
js_import nh_ratings from nh-ratings.js;

# The theme is INLINED into the HTML shell, so a browser that heuristically caches
# the shell keeps running an OLD theme build after a redeploy (stale until a hard
# refresh - mixed-version weirdness). Forbid caching of HTML responses only; the
# hashed /_nuxt/* assets keep whatever caching ABS gives them. add_header with an
# empty value emits nothing, so non-HTML responses are untouched.
map $upstream_http_content_type $nh_html_no_store {
    ~^text/html   "no-store";
    default       "";
}

server {
    listen 80;
    server_name _;
    client_max_body_size 0;

    # OIDC session cookie buffer support
    large_client_header_buffers 4 32k;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; media-src 'self' blob:; frame-ancestors 'self';" always;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Theme payload. SSI inlines these into the HTML below, so browsers never
    # request them directly and no cache-busting is needed. Kept addressable for
    # debugging (curl http://host/_nh/core.js).
    location /_nh/ {
        alias /usr/share/nginx/nh-theme/;
        add_header Cache-Control "public, max-age=60";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # UI-saved server defaults. GET is public: it is the same config every visitor
    # receives via the SSI include above, so there is nothing to protect.
    location = /_nh/server-config.json {
        alias /data/nh/server-config.json;
        default_type application/json;
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # Per-collection icon + accent overrides, chosen in the theme's collection UI.
    location = /_nh/collection-art.json {
        alias /data/nh/collection-art.json;
        default_type application/json;
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
        error_page 404 = @nh_empty_art;
    }
    location @nh_empty_art {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"v":1,"cols":{}}';
    }

    # Favicon overrides: direct browser requests for favicon.ico, favicon.png, apple-touch-icon
    # First checks if user mounted a custom /data/nh/favicon.png, otherwise falls back to built-in favicon
    location ~* ^/(favicon\.ico|favicon\.png|favicon-\d+x\d+\.png|apple-touch-icon.*\.png)$ {
        alias /data/nh/favicon.png;
        error_page 404 = /_nh/favicon.png;
        add_header Cache-Control "public, max-age=300";
        add_header Content-Type "image/png";
        access_log off;
    }

    location = /_nh/favicon.png {
        alias /usr/share/nginx/nh-theme/favicon.png;
        add_header Cache-Control "public, max-age=86400";
        add_header Content-Type "image/png";
        access_log off;
    }

    # Self-hosted custom logo - works with NO internet access.
    location ~ ^/_nh/(logo\.(?:png|svg|jpe?g|webp|gif|avif|ico))$ {
        alias /data/nh/$1;
        error_page 404 = /_nh/favicon.png;
        add_header Cache-Control "public, max-age=300";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # Custom series covers
    location ~ "^/_nh/series-covers/([A-Za-z0-9_-]{4,64}\.(?:png|jpe?g|webp|gif|avif))$" {
        alias /data/nh/series-covers/$1;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # Admin-written series description overrides, served as plain text
    location ~ "^/_nh/series-desc/([A-Za-z0-9_-]{4,64}\.txt)$" {
        alias /data/nh/series-desc/$1;
        default_type "text/plain; charset=utf-8";
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # User profile photos (avatars)
    location ~ "^/_nh/user-avatars/([A-Za-z0-9_-]{4,64}\.(?:png|jpe?g|webp|gif))$" {
        alias /data/nh/user-avatars/$1;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # Avatar write API (njs) - Admin only
    location = /_nh/api/avatar-admin {
        auth_request /_nh/admincheck;
        set $nh_avatar_admin 1;
        client_max_body_size 2m;
        client_body_buffer_size 2m;
        js_content nh_ratings.avatar;
    }

    # Series metadata probe (custom cover / description / avatar)
    location = /_nh/api/series-meta {
        auth_request /_nh/api/whoami;
        js_content nh_ratings.meta;
    }

    # Server-wide internal ratings (njs JSON API)
    location = /_nh/api/ratings {
        auth_request /_nh/api/whoami;
        client_max_body_size 64k;
        client_body_buffer_size 64k;
        js_content nh_ratings.handle;
    }

    # Moderation path: admin-gated
    location = /_nh/api/ratings-admin {
        auth_request /_nh/admincheck;
        set $nh_ratings_admin 1;
        client_max_body_size 64k;
        client_body_buffer_size 64k;
        js_content nh_ratings.handle;
    }

    # Problem reports: local internal reports
    location = /_nh/api/reports {
        auth_request /_nh/api/whoami;
        client_max_body_size 16k;
        client_body_buffer_size 16k;
        js_content nh_ratings.reports;
    }

    location = /_nh/api/reports-admin {
        auth_request /_nh/admincheck;
        set $nh_reports_admin 1;
        client_max_body_size 16k;
        client_body_buffer_size 16k;
        js_content nh_ratings.reports;
    }

    # Started-date overrides (local per-user)
    location = /_nh/api/dates {
        auth_request /_nh/api/whoami;
        client_max_body_size 8k;
        client_body_buffer_size 8k;
        js_content nh_ratings.dates;
    }

    # Per-user theme preferences
    location = /_nh/api/prefs {
        auth_request /_nh/api/whoami;
        client_max_body_size 32k;
        client_body_buffer_size 32k;
        js_content nh_ratings.prefs;
    }

    location = /_nh/api/whoami {
        internal;
        proxy_pass ${ABS_UPSTREAM}/api/me;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
    }

    # Admin-only write path for theme data (logo, series covers, server defaults)
    location /_nh/data/ {
        auth_request /_nh/admincheck;
        client_max_body_size 4m;
        dav_methods PUT DELETE;
        create_full_put_path on;
        alias /data/nh/;
    }

    location = /_nh/admincheck {
        internal;
        proxy_pass ${ABS_UPSTREAM}/api/users;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
    }

    # Public Mode / Guest session API (njs)
    location = /_nh/api/guest-session {
        set $nh_public_mode "${NH_PUBLIC_MODE}";
        set $nh_guest_username "${NH_GUEST_USERNAME}";
        set $nh_guest_password "${NH_GUEST_PASSWORD}";
        client_max_body_size 1k;
        js_content nh_ratings.guestSession;
    }

    location = /_nh/internal-abs-login {
        internal;
        proxy_pass ${ABS_UPSTREAM}/login;
        proxy_http_version 1.1;
        proxy_set_header Content-Type "application/json";
        proxy_set_header Accept "application/json";
        subrequest_output_buffer_size 128k;
        proxy_buffer_size 64k;
        proxy_buffers 8 64k;
        proxy_busy_buffers_size 128k;
    }

    location / {
        proxy_pass ${ABS_UPSTREAM};

        # Stale-shell guard: HTML must always revalidate.
        add_header Cache-Control $nh_html_no_store;

        # sub_filter cannot rewrite a compressed upstream body
        proxy_set_header Accept-Encoding "";

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nh_fwd_proto;

        # WebSocket (ABS Socket.IO progress sync)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_buffering off;
        proxy_buffer_size ${NH_PROXY_BUFFER_SIZE};
        proxy_buffers 8 ${NH_PROXY_BUFFER_SIZE};
        proxy_busy_buffers_size ${NH_PROXY_BUFFER_SIZE};
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        ssi on;
        ssi_silent_errors off;
        sub_filter_once on;

        # Injected header and theme scripts (zéro polices externes Google Fonts)
        sub_filter '</head>'
            '<link rel="icon" type="image/png" id="nh-favicon" href="/_nh/favicon.png"><style id="nh-fouc-blocker">html{background:${NH_FOUC_BG} !important;}body::after{content:"";position:fixed;inset:0;z-index:2147483000;background:radial-gradient(circle at 80% 0%,var(--nh-amber-shadow,rgba(224,194,122,0.30)) 0%,transparent 60%),radial-gradient(circle at 15% 100%,var(--nh-amber-tint,rgba(224,194,122,0.12)) 0%,transparent 55%),var(--nh-canvas,${NH_FOUC_BG});opacity:1;transition:opacity .45s ease;}html.nh-ready body::after{opacity:0;pointer-events:none;visibility:hidden;transition:opacity .45s ease,visibility 0s linear .5s;}body::before{content:"";position:fixed;top:50%;left:50%;width:38px;height:38px;margin:-19px 0 0 -19px;z-index:2147483001;border-radius:50%;border:3px solid var(--nh-amber-tint,rgba(224,194,122,0.14));border-top-color:var(--nh-amber,#e0c27a);box-shadow:0 0 28px var(--nh-amber-shadow,rgba(224,194,122,0.30));animation:nh-spin .9s linear infinite;transition:opacity .3s ease;}html.nh-ready body::before{opacity:0;visibility:hidden;animation:none;transition:opacity .3s ease,visibility 0s linear .35s;}@keyframes nh-spin{to{transform:rotate(360deg)}}</style><script>setTimeout(function(){document.documentElement.classList.add("nh-ready");},4000);</script><script>window.NH_CONFIG={"appName":"${NH_APP_NAME}","showLogoText":${NH_SHOW_LOGO_TEXT},"colorizeLogo":${NH_COLORIZE_LOGO},"logoUrl":"${NH_LOGO_URL}","accentColor":"${NH_ACCENT_COLOR}","baseTheme":"${NH_BASE_THEME}","mainFont":"${NH_MAIN_FONT}","fontScale":${NH_FONT_SCALE},"carouselTiming":${NH_CAROUSEL_TIMING},"showCustomRecentSeries":${NH_SHOW_RECENT_SERIES},"recentSeriesCount":${NH_RECENT_SERIES_COUNT},"customSeriesCards":${NH_CUSTOM_SERIES_CARDS},"showHeroCarousel":${NH_SHOW_HERO_CAROUSEL},"showRatings":${NH_SHOW_RATINGS},"globalSearch":${NH_GLOBAL_SEARCH},"publicMode":${NH_PUBLIC_MODE},"guestUsername":"${NH_GUEST_USERNAME}","themeVersion":"${THEME_VERSION}"};</script><script>window.NH_SERVER_CONFIG=<!--# include virtual="/_nh/server-config.json" -->;</script><script><!--# include virtual="/_nh/core.js" --></script><script><!--# include virtual="/_nh/nh-early.js" --></script></head>';

        sub_filter '</body>'
            '<script><!--# include virtual="/_nh/enhancements.js" --></script><script><!--# include virtual="/_nh/book-details.js" --></script></body>';
    }
}
